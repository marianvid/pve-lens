[Unit]
Description=PVE Lens read-only host collector
After=pve-cluster.service

[Service]
Type=simple
ExecStart=/usr/local/lib/pve-lens/collector.py
Restart=on-failure
RestartSec=3
RuntimeDirectory=pve-lens
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=restart
NoNewPrivileges=true
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
